    {
      "parameters": {
        "jsCode": "function randomToken(len) {\n  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';\n  let out = '';\n  for (let i = 0; i < len; i++) out += chars[Math.floor(Math.random() * chars.length)];\n  return out;\n}\nconst body = $json.body || {};\nconst name = (body.name || '').trim();\nconst email = (body.email || '').trim();\nreturn [{\n  json: {\n    valid: !!name && !!email,\n    name,\n    email,\n    token: randomToken(24)\n  }\n}];"
      },
      "id": "code-prepare-signup",
      "name": "Подготовить заявку",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "Имя и email заполнены?",
      "type": "n8n-nodes-base.if",
