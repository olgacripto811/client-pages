      "parameters": {
        "jsCode": "// Замените на username вашего Telegram-бота (без @).\nconst BOT_USERNAME = 'ЗАМЕНИТЬ_BOT_USERNAME';\nreturn [{\n  json: {\n    status: 'ok',\n    deep_link: `https://t.me/${BOT_USERNAME}?start=${$json.SignupToken || $('Подготовить заявку').item.json.token}`\n  }\n}];"
      },
