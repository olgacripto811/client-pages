{
  "name": "Команда · Рассылка (fanout, сабворкфлоу)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "message" },
            { "name": "sender" }
          ]
        }
      },
      "id": "trigger-execute-workflow",
      "name": "При вызове из другого воркфлоу",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-160, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "message", "type": "string", "value": "={{ $json.message }}" },
            { "id": "a2", "name": "sender", "type": "string", "value": "={{ $json.sender }}" },
            { "id": "a3", "name": "sentAt", "type": "string", "value": "={{ $now.toISO() }}" }
          ]
        },
        "options": {}
      },
      "id": "set-prepare",
      "name": "Prepare",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, 240]
    },
    {
      "parameters": {
        "operation": "search",
        "base": { "__rl": true, "mode": "id", "value": "ЗАМЕНИТЬ_AIRTABLE_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Team" },
        "filterByFormula": "={Status} = 'active'",
        "options": {}
      },
      "id": "airtable-get-active-team",
      "name": "Get active team",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [340, 120],
      "credentials": {
        "airtableTokenApi": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Airtable account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-tg",
              "leftValue": "={{ $json.TelegramChatID }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-telegram",
      "name": "IF есть Telegram",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 40]
    },
    {
      "parameters": {
        "chatId": "={{ $json.TelegramChatID }}",
        "text": "={{ $('Prepare').item.json.message }}",
        "additionalFields": {}
      },
      "id": "telegram-send",
      "name": "Telegram: отправить",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [860, 0],
      "credentials": {
        "telegramApi": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Telegram Bot" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-email",
              "leftValue": "={{ $json.Email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-email",
      "name": "IF есть Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 220]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Рассылка команды",
        "message": "={{ $('Prepare').item.json.message }}",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Gmail: отправить",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [860, 220],
      "credentials": {
        "gmailOAuth2": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "base": { "__rl": true, "mode": "id", "value": "ЗАМЕНИТЬ_AIRTABLE_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Messages" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Text": "={{ $json.message }}",
            "SentBy": "={{ $json.sender }}",
            "SentAt": "={{ $json.sentAt }}"
          }
        },
        "options": {}
      },
      "id": "airtable-log-message",
      "name": "Airtable: записать в ленту",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [340, 420],
      "credentials": {
        "airtableTokenApi": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Airtable account" }
      }
    }
  ],
  "connections": {
    "При вызове из другого воркфлоу": {
      "main": [[{ "node": "Prepare", "type": "main", "index": 0 }]]
    },
    "Prepare": {
      "main": [
        [
          { "node": "Get active team", "type": "main", "index": 0 },
          { "node": "Airtable: записать в ленту", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get active team": {
      "main": [
        [
          { "node": "IF есть Telegram", "type": "main", "index": 0 },
          { "node": "IF есть Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF есть Telegram": {
      "main": [[{ "node": "Telegram: отправить", "type": "main", "index": 0 }], []]
    },
    "IF есть Email": {
      "main": [[{ "node": "Gmail: отправить", "type": "main", "index": 0 }], []]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null
}
