{
  "name": "Команда · Рассылка (fanout, сабворкфлоу)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "message" },
            { "name": "sender" }
          ]
        }
      },
      "id": "trigger-execute-workflow",
      "name": "При вызове из другого воркфлоу",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-160, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "message", "type": "string", "value": "={{ $json.message }}" },
            { "id": "a2", "name": "sender", "type": "string", "value": "={{ $json.sender }}" },
            { "id": "a3", "name": "sentAt", "type": "string", "value": "={{ $now.toISO() }}" }
          ]
        },
        "options": {}
      },
      "id": "set-prepare",
      "name": "Prepare",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, 240]
    },
    {
      "parameters": {
        "operation": "search",
        "base": { "__rl": true, "mode": "id", "value": "ЗАМЕНИТЬ_AIRTABLE_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Team" },
        "filterByFormula": "={Status} = 'active'",
        "options": {}
      },
      "id": "airtable-get-active-team",
      "name": "Get active team",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [340, 120],
      "credentials": {
        "airtableTokenApi": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Airtable account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-tg",
              "leftValue": "={{ $json.TelegramChatID }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-telegram",
      "name": "IF есть Telegram",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 40]
    },
    {
      "parameters": {
        "jsCode": "// Собираем тело запроса к Telegram Bot API.\n// Кнопка \"Скопировать текст\" (copy_text) — нативная фича Telegram (Bot API 7.10+):\n// по нажатию текст копируется в буфер обмена получателя прямо в чате, без нашего бота.\n// У copy_text.text лимит 256 символов — если сообщение длиннее, кнопку не добавляем\n// (скопировать текст всё равно можно обычным long-press по сообщению в Telegram).\nconst message = $('Prepare').item.json.message;\nconst body = {\n  chat_id: $json.TelegramChatID,\n  text: message\n};\nif (message.length <= 256) {\n  body.reply_markup = {\n    inline_keyboard: [[\n      { text: '📋 Скопировать текст', copy_text: { text: message } }\n    ]]\n  };\n}\nreturn [{ json: { telegramBody: body } }];"
      },
      "id": "code-telegram-body",
      "name": "Собрать тело Telegram (с кнопкой копировать)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.telegramBody }}",
        "options": {}
      },
      "id": "telegram-send",
      "name": "Telegram: отправить",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-email",
              "leftValue": "={{ $json.Email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-email",
      "name": "IF есть Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 220]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Рассылка команды",
        "message": "={{ $('Prepare').item.json.message }}",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Gmail: отправить",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [860, 220],
      "credentials": {
        "gmailOAuth2": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "base": { "__rl": true, "mode": "id", "value": "ЗАМЕНИТЬ_AIRTABLE_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Messages" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Text": "={{ $json.message }}",
            "SentBy": "={{ $json.sender }}",
            "SentAt": "={{ $json.sentAt }}"
          }
        },
        "options": {}
      },
      "id": "airtable-log-message",
      "name": "Airtable: записать в ленту",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [340, 420],
      "credentials": {
        "airtableTokenApi": { "id": "ЗАМЕНИТЬ_CREDENTIAL_ID", "name": "Airtable account" }
      }
    }
  ],
  "connections": {
    "При вызове из другого воркфлоу": {
      "main": [[{ "node": "Prepare", "type": "main", "index": 0 }]]
    },
    "Prepare": {
      "main": [
        [
          { "node": "Get active team", "type": "main", "index": 0 },
          { "node": "Airtable: записать в ленту", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get active team": {
      "main": [
        [
          { "node": "IF есть Telegram", "type": "main", "index": 0 },
          { "node": "IF есть Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF есть Telegram": {
      "main": [[{ "node": "Собрать тело Telegram (с кнопкой копировать)", "type": "main", "index": 0 }], []]
    },
    "Собрать тело Telegram (с кнопкой копировать)": {
      "main": [[{ "node": "Telegram: отправить", "type": "main", "index": 0 }]]
    },
    "IF есть Email": {
      "main": [[{ "node": "Gmail: отправить", "type": "main", "index": 0 }], []]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null
}
